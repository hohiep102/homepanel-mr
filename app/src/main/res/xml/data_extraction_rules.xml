<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens use this headset's Keystore, and room anchors belong to this headset. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
